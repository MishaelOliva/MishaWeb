{
  "name": "misha-web",
  "private": true,
  "version": "2.6.0",
  "scripts": {
    "desktop:restore": "dotnet restore desktop.tests/MishaWeb.SmokeTests.csproj --locked-mode",
    "desktop:build": "dotnet build desktop/MishaWeb.csproj -c Release --warnaserror -p:ContinuousIntegrationBuild=true",
    "desktop:test": "dotnet run --project desktop.tests/MishaWeb.SmokeTests.csproj -c Release -p:RestoreLockedMode=true",
    "desktop:test:node": "node --test desktop.tests/ProbeLaunchContract.test.mjs desktop.tests/MemoryChurnAnalysis.test.mjs desktop.tests/MemoryAcceptanceProbe.test.mjs desktop.tests/ReaderModeScript.test.mjs desktop.tests/AdBlockDocumentScript.test.mjs",
    "desktop:check": "npm run desktop:restore && dotnet build desktop.tests/MishaWeb.SmokeTests.csproj -c Release --no-restore --warnaserror -p:ContinuousIntegrationBuild=true && dotnet run --project desktop.tests/MishaWeb.SmokeTests.csproj -c Release --no-build --no-restore && npm run desktop:test:node",
    "desktop:run": "dotnet run --project desktop/MishaWeb.csproj -c Release",
    "desktop:publish": "powershell -NoProfile -ExecutionPolicy Bypass -File build/Publish-MishaWeb.ps1 -Mode FrameworkDependent",
    "desktop:one-click": "powershell -NoProfile -ExecutionPolicy Bypass -File build/Publish-MishaWeb.ps1 -Mode OneClick",
    "desktop:portable": "powershell -NoProfile -ExecutionPolicy Bypass -File build/Publish-MishaWeb.ps1 -Mode Portable",
    "desktop:verify-publish": "powershell -NoProfile -ExecutionPolicy Bypass -File build/Publish-MishaWeb.ps1 -Mode FrameworkDependent -ValidateOnly",
    "desktop:verify-portable": "powershell -NoProfile -ExecutionPolicy Bypass -File build/Publish-MishaWeb.ps1 -Mode Portable -ValidateOnly",
    "desktop:install": "powershell -NoProfile -ExecutionPolicy Bypass -File build/Install-MishaWeb.ps1"
  }
}
